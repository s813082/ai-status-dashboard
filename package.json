{
  "name": "ai-status-dashboard",
  "version": "0.7.1",
  "private": true,
  "description": "本地常駐 web dashboard，讀 tokscale CLI 顯示 Claude Code / Codex 用量狀態",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "ai-status-dashboard": "bin/cli.js"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "start:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/start-dashboard.ps1",
    "setup:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/setup.ps1",
    "add-pet": "bash scripts/add-pet.sh",
    "test": "node --test test/*.test.js"
  }
}
